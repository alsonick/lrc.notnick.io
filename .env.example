# Postgres connection string, for the downloads counted on /usage. Without it nothing is stored.
# End it with sslmode=verify-full, not sslmode=require: the database driver warns about require.
DATABASE_URL=
DISCORD_WEBHOOK_URL=
LOGGING=
# Optional: a channel of their own for reviews from /usage. Without it they go to DISCORD_WEBHOOK_URL.
REVIEWS_WEBHOOK_URL=
